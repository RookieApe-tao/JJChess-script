<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XiangqiCore\XiangqiCore.csproj" />
  </ItemGroup>

  <!-- 诊断脚本（顶级语句，独立编译，默认排除；用 -p:Diag=true 构建） -->
  <ItemGroup Condition="'$(Diag)' != 'true'">
    <Compile Remove="diag\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(Diag)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="diag\DiagResync.cs" />
  </ItemGroup>

</Project>
